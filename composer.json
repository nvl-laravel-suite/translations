{
    "name": "nvl/translations",
    "description": "Translation catalog scanning, editing, import, and export for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "translations",
        "localization",
        "i18n"
    ],
    "require": {
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^7.0",
        "php": "^8.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/ownership": "^7.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-data": "^4.23"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Translations\\": "src/",
            "Nvl\\Translations\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Translations\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --configuration=phpunit.xml.dist --test-directory=tests --bootstrap=tests/Pest.php --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Translations\\Providers\\TranslationsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep",
            ".DS_Store"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts."
    },
    "conflict": {
        "nvl/ownership": "<7.0 || >=8.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/translations",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/translations",
        "docs": "https://github.com/nvl-laravel-suite/translations#readme",
        "issues": "https://github.com/nvl-laravel-suite/translations/issues",
        "security": "https://github.com/nvl-laravel-suite/translations/security/policy"
    }
}
